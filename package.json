{
  "name": "streamscrap-desktop",
  "version": "1.3.0",
  "author": "Teenix",
  "description": "Teenix desktop app",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "it.streamscrap.desktop",
    "productName": "Teenix",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server.py",
        "to": "server.py"
      },
      {
        "from": "scrapers",
        "to": "scrapers"
      },
      {
        "from": "web",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Teenix-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "teenager-dev",
        "repo": "teenix",
        "releaseType": "release"
      }
    ]
  }
}
